# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codeguard
POSTGRES_PORT=5432

# Application
PROJECT_NAME=CodeGuard AI
API_V1_STR=/api/v1
SECRET_KEY=your-super-secret-key-change-in-production-please

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI API Configuration (openai, claude, or grok)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here

# GitHub OAuth (create app at https://github.com/settings/developers)
# Callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth (create app in Google Cloud Console)
# Callback URL: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redis & Celery (set USE_CELERY=true when Redis is running)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Local development helpers
ENABLE_DEMO_FINDINGS=true
DEV_OAUTH_FALLBACK=true
